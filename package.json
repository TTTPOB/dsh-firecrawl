{
  "name": "@firecrawl/dsh-firecrawl",
  "description": "Firecrawl-backed search and fetch providers for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.2.0-fork1",
  "author": "Firecrawl <support@firecrawl.dev>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fetch": {
      "types": "./lib/fetch.d.ts",
      "default": "./lib/fetch.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/search/*.json",
    "./fetch/locale/*.json": "./locale/fetch/*.json",
    "./icon": "./assets/icon.svg",
    "./fetch/icon": "./assets/icon.svg"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "locale",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": "github:firecrawl/dsh-firecrawl",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "firecrawl",
    "web-search",
    "web-fetch",
    "scraping"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "prepare": "pnpm run build",
    "test": "vitest run --exclude 'tests/*.e2e.ts'",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.1",
    "@deepseek-ai/dsh-web": "0.2.1-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/dsh-web": "0.2.1-rc.1",
    "@types/node": "26.2.0",
    "js-yaml": "4.2.0",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.8",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6"
  }
}
